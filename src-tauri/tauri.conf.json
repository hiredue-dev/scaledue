{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScaleDue",
  "version": "0.1.0",
  "identifier": "com.hiredue.scaledue",
  "build": {
    "frontendDist": "../ui",
    "beforeBundleCommand": "node scripts/bundle-browsers.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ScaleDue — Creator Discovery",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../browser-bin/camoufox/": "browser-bin/camoufox/",
      "../browser-bin/playwright/": "browser-bin/playwright/",
      "../runner/": "runner/",
      "../browser/": "browser/",
      "../instagram/": "instagram/",
      "../scripts/": "scripts/",
      "../utils/": "utils/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
